# Bot wallet with KEEPER_ROLE on the deployed pool. Fund it with testnet USDC
# via https://faucet.circle.com (Arc Testnet, 20 USDC/day/address).
KEEPER_PRIVATE_KEY=

# LuckyStakerPool proxy address from `npm run deploy:arcTestnet` in /contracts.
POOL_ADDRESS=

# Only needed by `npm run index-history`. Cloudflare API token with D1 edit
# access (the same one already used for the site's domain setup works), and
# the Cloudflare account ID it belongs to.
CF_ACCOUNT_ID=
CF_API_TOKEN=
