# Deployer wallet for Arc Testnet (funds gas + deploys the proxy). Fund it via
# https://faucet.circle.com (select Arc Testnet).
DEPLOYER_PRIVATE_KEY=

# Bot wallet granted KEEPER_ROLE — used by the automation scripts to fund
# yield and run the weekly commit-reveal draw. Keep separate from the admin
# Safe multisig.
KEEPER_PRIVATE_KEY=

# Address of the admin Safe (2-of-2 multisig, see app.safe.global). Receives
# DEFAULT_ADMIN_ROLE on the proxy — controls upgrades, pause/unpause.
ADMIN_SAFE_ADDRESS=

# Arc Testnet predeployed USDC (see https://docs.arc.io/arc/references/contract-addresses)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
