{
  "name": "@luckypot/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "preview": "vite preview",
    "deploy": "npm run build:site && cd .. && npx wrangler pages deploy frontend/dist-site --project-name=luckypot --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.1.0",
    "@fontsource/roboto-condensed": "^5.1.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@privy-io/react-auth": "^2.4.2",
    "@privy-io/wagmi": "^1.0.2",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
